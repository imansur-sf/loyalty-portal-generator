{
  "name": "loyalty-portal-generator",
  "version": "1.0.0",
  "description": "Loyalty Portal Generator - Hosted on Heroku",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/test.cjs",
    "build:portal-css": "node scripts/build-portal-css.cjs",
    "check:portal-css": "node scripts/build-portal-css.cjs --check",
    "build:editor": "node scripts/build-editor.cjs",
    "build": "npm run build:portal-css && npm run build:editor && python3 build-standalone.py",
    "check:build": "node scripts/check-build.cjs",
    "heroku-postbuild": "npm run check:build && npm test"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19"
  }
}
